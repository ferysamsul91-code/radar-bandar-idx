{
  "manifest_version": 3,
  "name": "Radar Bandar IDX",
  "version": "0.14.0",
  "description": "Membaca running trade, orderbook & Broker Summary Stockbit yang tampil di layar (read-only). Bukan rekomendasi beli/jual.",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["https://api.github.com/*"],
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": ["https://stockbit.com/orderbook*", "https://stockbit.com/symbol/*", "https://stockbit.com/broker-analysis/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
